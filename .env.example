# Server
PORT=5000
NODE_ENV=development

# MySQL (existing CRM)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=reparv
DB_PORT=3306

# OpenAI — Real Estate AI Agent
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_AGENT_ENABLED=1
# Optional: require x-ai-api-key (or body apiKey) on POST /api/ai/chat
# AI_AGENT_PUBLIC_KEY=your-secret-key
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RAG_CHUNK_SIZE=900
AI_RAG_CHUNK_OVERLAP=120
AI_RAG_TOP_K=6

# WhatsApp Cloud API (existing)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
